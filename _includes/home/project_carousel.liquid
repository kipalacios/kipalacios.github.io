<!-- Placeholder: currently loops over the theme's demo _portfolio entries.
     Swap in real project pages and this carousel updates automatically. -->
<section class="project-carousel" data-carousel data-testid="project-carousel" aria-roledescription="carousel" aria-label="Featured projects">
    <h2 class="project-carousel__heading">Media Specializations</h2>
    <div class="project-carousel__row">
        <button type="button" class="project-carousel__arrow project-carousel__arrow--prev" data-carousel-prev aria-label="Previous project">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 7 12l8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="project-carousel__viewport">
            <div class="project-carousel__track" data-carousel-track>
                {% for item in site.portfolio %}
                <article class="project-carousel__slide{% if forloop.first %} is-active{% endif %}" data-carousel-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}">
                    <div class="project-carousel__image-wrap">
                        <img class="project-carousel__image" src="{{ item.img | relative_url }}" alt="{{ item.title }}">
                    </div>
                    <div class="project-carousel__caption">
                        <h3 class="project-carousel__title">{{ item.title }}</h3>
                        <p class="project-carousel__desc">{{ item.excerpt | strip_html | strip_newlines | truncate: 110 }}</p>
                        <a class="project-carousel__link" href="{{ item.redirect_url | default: item.url | relative_url }}">View project &rarr;</a>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>

        <button type="button" class="project-carousel__arrow project-carousel__arrow--next" data-carousel-next aria-label="Next project">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
    </div>

    <div class="project-carousel__dots" role="tablist" aria-label="Choose a project">
        {% for item in site.portfolio %}
        <button type="button" class="project-carousel__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ item.title }}"></button>
        {% endfor %}
    </div>
</section>
