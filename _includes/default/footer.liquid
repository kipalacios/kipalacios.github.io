<footer class="site-footer">
    <div class="site-footer__inner">
        <p class="site-footer__name">Klarissa Palacios</p>
        <p class="site-footer__tagline">Create More Than You Consume</p>

        <nav class="site-footer__nav" aria-label="Footer">
            <a href="{{ '/about/' | relative_url }}">About</a>
            <a href="{{ '/content-creation/' | relative_url }}">Content Creation &amp; UGC</a>
            <a href="{{ '/portfolio/' | relative_url }}">Portfolio</a>
            <a href="mailto:klarissaipalacios@gmail.com">Contact</a>
        </nav>

        <div class="site-footer__icons">
            <ul>
                {% include social/icons.liquid %}
            </ul>
        </div>

        <p class="site-footer__copyright">&copy; {{ "now" | date: "%Y" }} Klarissa Palacios. All rights reserved.</p>
    </div>
    {% if site.mermaid %}
        <script type="module">
          mermaid.initialize({ startOnLoad: false, theme: "default" });
          mermaid.run({ nodes: [...document.querySelectorAll('.language-mermaid'), ...document.querySelectorAll('.mermaid')] });
        </script>
    {% endif %}
</footer>
