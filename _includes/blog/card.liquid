{% comment %}
One blog post card on the Blog page (_layouts/blog-index.liquid).

  post — a post from site.posts
{% endcomment %}
{% assign post = include.post %}
{% assign words = post.content | strip_html | number_of_words %}
{% assign minutes = words | divided_by: 200 | at_least: 1 %}
<a class="blog-card" href="{{ post.url | relative_url }}" data-category="{{ post.category | slugify }}">
    <div class="blog-card__image-wrap">
        {% if post.cover %}
        <img class="blog-card__image" src="{{ post.cover | relative_url }}" alt="{{ post.cover_alt | default: post.title }}" loading="lazy">
        {% endif %}
    </div>
    <div class="blog-card__body">
        <p class="blog-card__meta">{{ post.date | date: "%B %-d, %Y" }} &middot; {% if post.original_publication %}Originally in the {{ post.original_publication }}{% else %}{{ minutes }} min read{% endif %}</p>
        <h2 class="blog-card__title">{{ post.title }}</h2>
        {% assign blurb = post.description | default: post.excerpt %}
        {% if blurb %}<p class="blog-card__desc">{{ blurb | strip_html | truncatewords: 28 }}</p>{% endif %}
        <span class="blog-card__link">Read post &rarr;</span>
    </div>
</a>
