---
layout: default
---
<article class="case-study">

  <header class="case-hero">
    <div class="case-hero__inner">
      {% if page.concept %}<p class="case-hero__badge">Concept Campaign</p>{% endif %}
      <h1 class="case-hero__title">{{ page.title }}</h1>
      {% if page.tagline %}<p class="case-hero__tagline">&ldquo;{{ page.tagline }}&rdquo;</p>{% endif %}
      <div class="case-hero__meta">
        {% if page.client %}<span><strong>Client</strong> {{ page.client }}</span>{% endif %}
        {% if page.industry %}<span><strong>Industry</strong> {{ page.industry | join: ' &middot; ' }}</span>{% endif %}
        {% if page.role %}<span><strong>Role</strong> {{ page.role }}</span>{% endif %}
      </div>
      {% if page.summary %}<p class="case-hero__summary">{{ page.summary }}</p>{% endif %}
      {% if page.concept_note %}<p class="case-hero__note">{{ page.concept_note }}</p>{% endif %}
    </div>
  </header>

  {% if page.overview %}
  <section class="case-band case-band--yellow">
    <div class="case-band__sparkles" aria-hidden="true">
      {% include home/sparkle.liquid class="case-band__sparkle case-band__sparkle--1" %}
      {% include home/sparkle.liquid class="case-band__sparkle case-band__sparkle--2" %}
    </div>
    <div class="case-band__inner">
      <p class="case-band__eyebrow">The Brief</p>
      <div class="case-overview">
        {% if page.overview.problem %}
        <div class="case-overview__item">
          <h3>The Problem</h3>
          <p>{{ page.overview.problem }}</p>
        </div>
        {% endif %}
        {% if page.overview.goal %}
        <div class="case-overview__item">
          <h3>The Goal</h3>
          <p>{{ page.overview.goal }}</p>
        </div>
        {% endif %}
        {% if page.overview.audience_primary %}
        <div class="case-overview__item">
          <h3>Primary Audience</h3>
          <p>{{ page.overview.audience_primary }}</p>
        </div>
        {% endif %}
        {% if page.overview.audience_secondary %}
        <div class="case-overview__item">
          <h3>Secondary Audience</h3>
          <p>{{ page.overview.audience_secondary }}</p>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if page.paid %}
  <section class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">Paid Media</p>
      <h2 class="case-section__title">Creative Brief &amp; Placement Strategy</h2>

      {% if page.paid.tagline_strategy %}
      <p class="case-section__lead">{{ page.paid.tagline_strategy }}</p>
      {% endif %}

      <div class="case-channels">
        {% if page.paid.ooh %}
        <div class="case-channels__col">
          <h4>Out-of-Home</h4>
          <ul>{% for item in page.paid.ooh %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if page.paid.digital %}
        <div class="case-channels__col">
          <h4>Digital</h4>
          <ul>{% for item in page.paid.digital %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
        {% if page.paid.print %}
        <div class="case-channels__col">
          <h4>Print &amp; Newsletters</h4>
          <ul>{% for item in page.paid.print %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if page.earned %}
  <section class="case-section case-section--tint">
    <div class="case-section__inner">
      <p class="case-section__label">Earned Media</p>
      <h2 class="case-section__title">Thought Leadership Op-Ed</h2>
      <div class="case-article">
        <h3 class="case-article__headline">{{ page.earned.headline }}</h3>
        {% if page.earned.subhead %}<p class="case-article__subhead">{{ page.earned.subhead }}</p>{% endif %}
        <p class="case-article__byline">{{ page.earned.byline }}<br>{{ page.earned.dateline }}</p>
        {% for paragraph in page.earned.body_paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
      {% if page.earned.strategy_note %}
      <div class="case-note">
        <p class="case-note__label">Why This Works</p>
        <p>{{ page.earned.strategy_note }}</p>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if page.shared %}
  <section class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">Shared Media</p>
      <h2 class="case-section__title">Blog Post</h2>
      <div class="case-article">
        {% if page.shared.blog_title %}<h3 class="case-article__headline">{{ page.shared.blog_title }}</h3>{% endif %}
        {% for paragraph in page.shared.blog_paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>
  </section>

  {% if page.shared.instagram_posts %}
  <section class="case-section case-section--tint">
    <div class="case-section__inner">
      <p class="case-section__label">Shared Media</p>
      <h2 class="case-section__title">Instagram Series</h2>
      <div class="case-ig-carousel" data-carousel>
        <div class="case-ig-carousel__row">
          <button type="button" class="case-ig-carousel__arrow case-ig-carousel__arrow--prev" data-carousel-prev aria-label="Previous post">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 7 12l8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="case-ig-carousel__viewport">
            <div class="case-ig-carousel__track" data-carousel-track>
              {% for post in page.shared.instagram_posts %}
              <div class="case-ig-carousel__slide{% if forloop.first %} is-active{% endif %}" data-carousel-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                <img src="{{ post.image | relative_url }}" alt="{{ post.alt | default: page.shared.blog_title }}" loading="lazy">
                {% if post.caption %}<p class="case-ig-carousel__caption">{{ post.caption }}</p>{% endif %}
              </div>
              {% endfor %}
            </div>
          </div>
          <button type="button" class="case-ig-carousel__arrow case-ig-carousel__arrow--next" data-carousel-next aria-label="Next post">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="case-ig-carousel__dots" role="tablist" aria-label="Choose a post">
          {% for post in page.shared.instagram_posts %}
          <button type="button" class="case-ig-carousel__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Post {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% if page.shared.newsletter_image %}
  <section class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">Shared Media</p>
      <h2 class="case-section__title">Newsletter Placement</h2>
      <img class="case-newsletter" src="{{ page.shared.newsletter_image | relative_url }}" alt="{{ page.shared.newsletter_alt | default: 'Newsletter design' }}" loading="lazy">
    </div>
  </section>
  {% endif %}
  {% endif %}

  {% if page.owned.swot %}
  <section class="case-section case-section--tint">
    <div class="case-section__inner">
      <p class="case-section__label">Owned Media</p>
      <h2 class="case-section__title">SWOT Analysis</h2>
      <div class="case-swot">
        {% for quad in page.owned.swot %}
        <div class="case-swot__card case-swot__card--{{ quad.key }}">
          <h4>{{ quad.label }}</h4>
          <ul>
            {% for point in quad.points %}
            <li><strong>{{ point.title }}</strong><span>{{ point.rationale }}</span></li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if page.owned.recommendations %}
  <section class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">Owned Media</p>
      <h2 class="case-section__title">Strategic Recommendations &amp; Key Metrics</h2>
      <div class="case-recs">
        {% for rec in page.owned.recommendations %}
        <div class="case-recs__item">
          <h4>{{ forloop.index }}. {{ rec.title }}</h4>
          <p>{{ rec.body }}</p>
          {% if rec.metrics %}
          <ul class="case-recs__metrics">
            {% for m in rec.metrics %}<li>{{ m }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <footer class="case-footer">
    <a class="button case-footer__cta" href="{{ '/portfolio/' | relative_url }}">&larr; Back to Portfolio</a>
  </footer>

</article>

<script defer src="{{ '/assets/js/project-carousel.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
