<!-- A planned-but-not-yet-produced visual asset. Deliberately reads as an
     intentional slot in the campaign plan (labelled, with the creative
     direction spelled out) rather than a broken or missing image.
     Params: label (required), note, ratio (css aspect-ratio, default 4/3),
     kind (photo|video|social|print — picks the icon). -->
{% assign ratio = include.ratio | default: '4 / 3' %}
{% assign kind = include.kind | default: 'photo' %}
<figure class="asset-ph" style="--ph-ratio: {{ ratio }};">
    <div class="asset-ph__frame">
        <svg class="asset-ph__icon" viewBox="0 0 24 24" aria-hidden="true">
            {% case kind %}
            {% when 'video' %}
            <path d="M4 5h11a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm12 5.5 5-3v9l-5-3"
                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
            {% when 'social' %}
            <rect x="4" y="3" width="16" height="18" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="12" cy="11" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/>
            {% when 'print' %}
            <path d="M6 3h12v6H6zM4 9h16v7H4zM7 16h10v5H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            {% else %}
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="8.5" cy="10" r="1.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="m4 17 4.5-4.5 3.5 3.5 3-2.5L20 17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
            {% endcase %}
        </svg>
        <span class="asset-ph__tag">Asset in development</span>
    </div>
    <figcaption class="asset-ph__caption">
        <strong>{{ include.label }}</strong>
        {% if include.note %}<span>{{ include.note }}</span>{% endif %}
    </figcaption>
</figure>
