---
layout: default
---
{% comment %}
Site search. Uses the site's banner and styling (.search-page in
_sass/_custom.scss) rather than the theme's photo header; the search itself
is unchanged — SimpleJekyllSearch over /assets/data/search.liquid, loaded
site-wide by the theme.
{% endcomment %}
<div class="call-out call-out_solid">
    <h1 class="call-out_title">{{ page.title }}</h1>
</div>

<section class="search-page">
    {% if page.subtitle %}<p class="search-page__lead">{{ page.subtitle }}</p>{% endif %}

    <div class="search-page__field">
        <label class="search-page__label" for="search-input">Search the site</label>
        <i class="fas fa-search search-page__icon" aria-hidden="true"></i>
        <input type="text" id="search-input" placeholder="Enter keywords..." class="search-bar" autocomplete="off" autofocus>
    </div>

    {% comment %} Topic chips: one click fills the search box and runs the search.
    Edit the list freely. {% endcomment %}
    {% assign search_topics = "Op-Ed,UGC,Survey,Photography,Accessibility,News Release,Newsletter" | split: "," %}
    <div class="search-page__topics" role="group" aria-label="Popular searches">
        <span class="search-page__topics-label">Try:</span>
        {% for t in search_topics %}<button type="button" class="search-page__topic" data-search-topic="{{ t }}">{{ t }}</button>{% endfor %}
    </div>

    <ul id="results-container" class="search-page__results" aria-live="polite"></ul>
</section>
<script>
    document.querySelectorAll('[data-search-topic]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            var input = document.getElementById('search-input');
            input.value = chip.getAttribute('data-search-topic');
            input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.focus();
        });
    });
</script>

{% comment %}
Media Specializations lives here now (it's out of the navbar): browse all
work by PESO channel under the search box. Same include + filter script as
the standalone /media-specializations/ page, which still works for old links.
{% endcomment %}
<div class="search-browse" id="media-specializations">
    <h2 class="search-browse__title">Media Specializations</h2>
    {% include portfolio/peso_gallery.liquid %}
</div>
<script defer src="{{ '/assets/js/peso-gallery.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>

<script type="text/javascript">
    SimpleJekyllSearch({
        searchInput: document.getElementById('search-input'),
        resultsContainer: document.getElementById('results-container'),
        json: '{{ "/assets/data/search.liquid" | relative_url }}',
        searchResultTemplate: '<li class="search-result" data-testid="search-result-item"><a class="search-result__link" href="{url}" data-testid="search-result-link"><h3 class="search-result__title">{title}</h3></a><p class="search-result__excerpt">{content}</p></li>',
        noResultsText: '{{ site.data.language.str_no_result_found | default: "No result found" }}',
        limit: 10,
        strategy: {
            type: 'hybrid',
        },
        sortMiddleware: window.RelevanceSort,
        exclude: [],
        templateMiddleware: window.createHighlightTemplateMiddleware({
            className: 'search-highlight',
            maxLength: 100,
            contextLength: 150
        })
    })
</script>
