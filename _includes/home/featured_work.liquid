{% comment %}
Three-card teaser strip right after the homepage intro — one example each
from Campaigns, Content Creation & UGC, and Research, so a first-time
visitor sees the full range of work before deciding where to click deeper.
Deliberately lighter than a .portfolio-index__card (image, title, one-line
subtitle, link only — no tagline/description/course) since this is a fast
scan, not a full listing; the dedicated section for each category is where
the depth lives. The three categories are named once in the subheading
below the section title rather than as a per-card badge overlaying the
image, so nothing sits on top of the photo itself.

Swap `campaign` below to feature a different campaign later — everything
else keys off its own front matter, so no other line needs to change.
{% endcomment %}
{% assign campaign = site.portfolio | where: 'url', '/portfolio/cava-bumble/' | first %}
{% assign research = site.research | first %}
<section class="featured-work">
    <div class="featured-work__inner">
        <h2 class="featured-work__heading">Featured Work</h2>
        <p class="featured-work__subheading">Campaigns, Professional Work, and Research</p>

        <div class="featured-work__grid">
            {% if campaign %}
            <a class="featured-work__card" href="{{ campaign.url | relative_url }}">
                <div class="featured-work__image-wrap">
                    <img class="featured-work__image" src="{{ campaign.img | relative_url }}" alt="{{ campaign.title }}" loading="lazy">
                </div>
                <div class="featured-work__body">
                    <h3 class="featured-work__title">{{ campaign.title }}</h3>
                    {% if campaign.tagline %}<p class="featured-work__subtitle">&ldquo;{{ campaign.tagline }}&rdquo;</p>{% endif %}
                    <span class="featured-work__link">View project &rarr;</span>
                </div>
            </a>
            {% endif %}

            {% assign ysc = site.portfolio | where: 'url', '/portfolio/ysc-la-newsletter/' | first %}
            {% if ysc %}
            <a class="featured-work__card" href="{{ ysc.url | relative_url }}">
                <div class="featured-work__image-wrap">
                    <img class="featured-work__image featured-work__image--top" src="{{ ysc.img | relative_url }}" alt="{{ ysc.img_alt | default: ysc.title | strip_html | strip }}" loading="lazy">
                </div>
                <div class="featured-work__body">
                    <h3 class="featured-work__title">2025 Year-in-Review Report</h3>
                    <p class="featured-work__subtitle">Co-written for Youth Service Corps LA, City of Los Angeles</p>
                    <span class="featured-work__link">Read the report &rarr;</span>
                </div>
            </a>
            {% endif %}

            {% if research %}
            <a class="featured-work__card" href="{{ research.url | relative_url }}">
                <div class="featured-work__image-wrap">
                    <img class="featured-work__image featured-work__image--contain" src="{{ research.img | relative_url }}" alt="{{ research.img_alt | default: research.title }}" loading="lazy">
                </div>
                <div class="featured-work__body">
                    <h3 class="featured-work__title">{{ research.title }}</h3>
                    {% if research.subtitle %}<p class="featured-work__subtitle">{{ research.subtitle }}</p>{% endif %}
                    <span class="featured-work__link">Read the study &rarr;</span>
                </div>
            </a>
            {% endif %}
        </div>
    </div>
</section>
