---
layout: default
---
{% comment %}
A campaign that lives on one page, for work without a full PESO spread —
here a brand-voice narrative plus its paid and owned creative. Open Mind and
Rare Hair use campaign-hub with a page per pillar; this keeps the same
furniture (banner, case-hero, case-band, the creative grid) without inventing
empty sections. Every block is optional.
{% endcomment %}
<div class="call-out call-out_solid">
    <h1 class="call-out_title">{{ page.title }}</h1>
</div>

<article class="case-study"{% if page.accent %} style="--campaign-accent: {{ page.accent }};"{% endif %}>

  <header class="case-hero">
    <div class="case-hero__inner">
      {% comment %}Concept / Professional Work badge: hidden for now. To bring it back, remove this comment wrapper.{% endcomment %}{% comment %}
        {% if page.concept %}<p class="case-hero__badge">Concept Campaign</p>
      {% elsif page.concept == false %}<p class="case-hero__badge case-hero__badge--work">Professional Work</p>{% endif %}
        {% endcomment %}
      {% if page.tagline %}<p class="case-hero__tagline">&ldquo;{{ page.tagline }}&rdquo;</p>{% endif %}
      <div class="case-hero__meta">
        {% if page.client %}<span><strong>Client</strong> {{ page.client }}</span>{% endif %}
        {% if page.course %}<span><strong>{{ page.course_label | default: 'Course' }}</strong> {{ page.course }}{% if page.date_label %} &middot; {{ page.date_label }}{% endif %}</span>{% endif %}
        {% if page.role %}<span><strong>My role</strong> {{ page.role }}</span>{% endif %}
        {% if page.industry %}<span><strong>Industry</strong> {{ page.industry | join: ' &middot; ' }}</span>{% endif %}
      </div>
      {% if page.summary %}<p class="case-hero__summary">{{ page.summary }}</p>{% endif %}
      {% if page.concept_note %}<p class="case-hero__note">{{ page.concept_note }}</p>{% endif %}
    </div>
  </header>

  {% comment %} Video projects: set `video: { youtube_id, label, title, note }` in front matter.
  Uses YouTube's privacy-enhanced (no-cookie) player. {% endcomment %}
  {% if page.video.youtube_id %}
  <section id="video" class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">{{ page.video.label | default: 'Video' }}</p>
      <h2 class="case-section__title">{{ page.video.title | default: 'Watch' }}</h2>
      {% if page.video.note %}<p class="case-section__lead">{{ page.video.note }}</p>{% endif %}
      <div class="case-video">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ page.video.youtube_id }}" title="{{ page.video.title | default: page.title | strip_html }}" loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
      {% if page.video.url %}<p class="case-video__link"><a href="{{ page.video.url }}" target="_blank" rel="noopener">Watch on YouTube &rarr;</a></p>{% endif %}
    </div>
  </section>
  {% endif %}

  {% comment %} Same flip-through-plus-download pattern as the research decks: the pages lead, ten seconds of flipping gives the gist before the detail below. {% endcomment %}
  {% if page.presentation %}
  <section id="deck" class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">{{ page.presentation.label | default: 'Presentation' }}</p>
      <h2 class="case-section__title">{{ page.presentation.title | default: 'The Deck' }}</h2>
      {% if page.presentation.note %}<p class="case-section__lead">{{ page.presentation.note }}</p>{% endif %}
      {% include campaign/deck_carousel.liquid deck=page.presentation %}
      {% if page.presentation.pdf %}
      <div class="deck-actions">
        {% include campaign/pdf_link.liquid href=page.presentation.pdf label=page.presentation.pdf_label %}
      </div>
      {% endif %}
    </div>
  </section>
  {% comment %} Same [data-carousel] driver as campaign/creatives.liquid's carousel groups; guarded so a page using both loads it once. {% endcomment %}
  {% unless creative_carousel_js %}
  {% assign creative_carousel_js = true %}
  <script defer src="{{ '/assets/js/project-carousel.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
  {% endunless %}
  {% endif %}

  {% if page.overview %}
  <section id="brief" class="case-band case-band--yellow">
    <div class="case-band__sparkles" aria-hidden="true">
      {% include home/sparkle.liquid class="case-band__sparkle case-band__sparkle--1" %}
      {% include home/sparkle.liquid class="case-band__sparkle case-band__sparkle--2" %}
    </div>
    <div class="case-band__inner">
      <p class="case-band__eyebrow">The Brief</p>
      <div class="case-overview">
        {% if page.overview.assignment %}
        <div class="case-overview__item"><h3>The Assignment</h3><p>{{ page.overview.assignment }}</p></div>
        {% endif %}
        {% if page.overview.idea %}
        <div class="case-overview__item"><h3>The Idea</h3><p>{{ page.overview.idea }}</p></div>
        {% endif %}
        {% if page.overview.audience %}
        <div class="case-overview__item"><h3>Audience</h3><p>{{ page.overview.audience }}</p></div>
        {% endif %}
        {% if page.overview.product %}
        <div class="case-overview__item"><h3>The Product</h3><p>{{ page.overview.product }}</p></div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {% comment %} The narrative, told in the product's own voice, as a timeline. {% endcomment %}
  {% if page.story %}
  <section id="story" class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">{{ page.story_label | default: 'The Copy' }}</p>
      <h2 class="case-section__title">{{ page.story_title | default: 'A Day in the Life' }}</h2>
      {% if page.story_intro %}<p class="glow-story__intro">{{ page.story_intro }}</p>{% endif %}
    </div>

    <div class="glow-story">
      {% for s in page.story %}
      <div class="glow-story__item{% unless s.img %} glow-story__item--text-only{% endunless %}">
        <div class="glow-story__text">
          {% if s.time %}<p class="glow-story__time">{{ s.time }}</p>{% endif %}
          {% if s.title %}<h3 class="glow-story__title">{{ s.title }}</h3>{% endif %}
          {% if s.body %}<p class="glow-story__body">{{ s.body }}</p>{% endif %}
        </div>
        {% if s.img %}
        <figure class="glow-story__figure">
          <img src="{{ s.img | relative_url }}" alt="{{ s.alt }}" loading="lazy">
        </figure>
        {% endif %}
      </div>
      {% endfor %}

      {% if page.story_closer %}
      <p class="glow-story__closer">{{ page.story_closer }}</p>
      {% endif %}

      {% if page.product_url %}
      <div class="deck-actions glow-story__cta">
        <a class="deck-actions__primary" href="{{ page.product_url }}" target="_blank" rel="noopener noreferrer">
          <span>{{ page.product_url_label | default: 'See the real product' }}</span>
        </a>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% comment %} Each group of finished creative, using the same grid as the other campaigns. {% endcomment %}
  {% for group in page.creative_groups %}
  {% include campaign/creatives.liquid items=group.items title=group.title carousel=group.carousel narrow=group.narrow %}
  {% endfor %}

  {% comment %} Instagram posts, shown with Instagram's own embed so the photos
  and caption stay on Instagram. Either one section (`instagram_posts:` list of
  {url}, headed by `instagram_label` / `instagram_title` / `instagram_note`) or
  several (`instagram_sections:` list of {label, title, note, posts}).
  Two or more posts in a section sit side by side on desktop. {% endcomment %}
  {% assign ig_sections = page.instagram_sections %}
  {% if ig_sections or page.instagram_posts %}
  {% if ig_sections %}{% assign ig_count = ig_sections.size %}{% else %}{% assign ig_count = 1 %}{% endif %}
  {% for n in (1..ig_count) %}
    {% if ig_sections %}
      {% assign ig = ig_sections[forloop.index0] %}
      {% assign ig_label = ig.label %}{% assign ig_title = ig.title %}{% assign ig_note = ig.note %}{% assign ig_posts = ig.posts %}
    {% else %}
      {% assign ig_label = page.instagram_label %}{% assign ig_title = page.instagram_title %}{% assign ig_note = page.instagram_note %}{% assign ig_posts = page.instagram_posts %}
    {% endif %}
  <section {% if forloop.first %}id="instagram" {% endif %}class="case-section">
    <div class="case-section__inner">
      <p class="case-section__label">{{ ig_label | default: 'On Instagram' }}</p>
      <h2 class="case-section__title">{{ ig_title | default: 'From Instagram' }}</h2>
      {% if ig_note %}<p class="case-section__lead">{{ ig_note }}</p>{% endif %}
      <div class="case-instagram{% if ig_posts.size > 1 %} case-instagram--grid{% endif %}">
        {% for post in ig_posts %}
        <blockquote class="instagram-media" data-instgrm-permalink="{{ post.url }}?utm_source=ig_embed" data-instgrm-version="14" data-instgrm-captioned>
          <a href="{{ post.url }}" target="_blank" rel="noopener">View this post on Instagram &rarr;</a>
        </blockquote>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endfor %}
  <script async src="https://www.instagram.com/embed.js"></script>
  {% endif %}

  {% comment %} Notable projects (`notable_projects:`): a project within the program,
  with my role, a short timeline, a photo carousel and links out. {% endcomment %}
  {% if page.notable_projects %}
  <section id="notable-projects" class="case-section notable-projects">
    <div class="case-section__inner">
      <p class="case-section__label">{{ page.notable_projects_label | default: 'Notable Projects' }}</p>
      <h2 class="case-section__title">{{ page.notable_projects_title | default: 'Notable Projects' }}</h2>
      {% for p in page.notable_projects %}
      <div class="notable-project">
        <h3 class="notable-project__title">{{ p.title }}</h3>
        {% if p.meta %}<p class="notable-project__meta">{{ p.meta }}</p>{% endif %}
        {% if p.summary %}<p class="notable-project__summary">{{ p.summary }}</p>{% endif %}
        {% if p.role %}
        <div class="notable-project__role">
          <p class="notable-project__role-label">My Role</p>
          <p>{{ p.role }}</p>
        </div>
        {% endif %}
        {% if p.quote %}
        <blockquote class="notable-project__quote">
          <p>&ldquo;{{ p.quote }}&rdquo;</p>
          {% if p.quote_source %}<cite>{% if p.quote_url %}<a href="{{ p.quote_url }}" target="_blank" rel="noopener">{{ p.quote_source }}</a>{% else %}{{ p.quote_source }}{% endif %}</cite>{% endif %}
        </blockquote>
        {% endif %}
        {% if p.timeline %}
        <p class="notable-project__timeline-label">Project Timeline</p>
        <ol class="notable-project__timeline" style="--steps: {{ p.timeline.size }};">
          {% for t in p.timeline %}
          <li class="notable-project__step{% if forloop.last %} is-final{% endif %}">
            <span class="notable-project__dot" aria-hidden="true">{{ forloop.index }}</span>
            <span class="notable-project__when">{{ t.when }}</span>
            <strong>{{ t.title }}</strong>
            <span class="notable-project__step-text">{{ t.text }}</span>
          </li>
          {% endfor %}
        </ol>
        {% endif %}
        <div class="notable-project__photos">
        {% include campaign/creatives.liquid items=p.photos carousel=true bare=true title=p.title %}
        </div>
        {% if p.credit %}<p class="notable-project__credit">{{ p.credit }}</p>{% endif %}
        {% if p.links %}
        <ul class="notable-project__links">
          {% for l in p.links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} &rarr;</a></li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer class="case-footer">
    <a class="button case-footer__cta" href="{{ '/campaigns/' | relative_url }}">&larr; Back to Campaigns</a>
  </footer>

</article>
