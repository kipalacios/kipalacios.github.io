<!-- Produced creative work for a pillar or a campaign group. Sits above that
     pillar's placeholders, so a page reads finished-work-first,
     planned-work-second.
     Params: items (array of {image, label, note, alt}), title,
             carousel (true to page through them instead of stacking — for a
             set of same-shaped pieces like four portrait Instagram ads,
             which stack to ~860px each in the grid). -->
{% if include.items %}
<section class="case-section">
    <div class="case-section__inner">
        <p class="case-section__label">Creative</p>
        <h2 class="case-section__title">{{ include.title | default: 'The Work' }}</h2>

        {% if include.carousel and include.items.size > 1 %}
        {% comment %} Same [data-carousel] contract as the deck and project carousels. {% endcomment %}
        <div class="creative-carousel" data-carousel aria-roledescription="carousel" aria-label="{{ include.title | default: 'Creative' }}">
            <div class="creative-carousel__row">
                <button type="button" class="creative-carousel__arrow" data-carousel-prev aria-label="Previous piece">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 7 12l8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>

                <div class="creative-carousel__viewport">
                    <div class="creative-carousel__track" data-carousel-track>
                        {% for c in include.items %}
                        <div class="creative-carousel__slide{% if forloop.first %} is-active{% endif %}" data-carousel-slide
                             aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                             aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}">
                            <figure class="creative creative--compact">
                                <img class="creative__img" src="{{ c.image | relative_url }}" alt="{{ c.alt | default: c.label }}"
                                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
                                <figcaption class="creative__caption">
                                    <strong>{{ c.label }}</strong>
                                    {% if c.note %}<span>{{ c.note }}</span>{% endif %}
                                </figcaption>
                            </figure>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <button type="button" class="creative-carousel__arrow" data-carousel-next aria-label="Next piece">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>

            <div class="creative-carousel__dots" role="tablist" aria-label="Choose a piece">
                {% for c in include.items %}
                <button type="button" class="creative-carousel__dot{% if forloop.first %} is-active{% endif %}" data-carousel-dot
                        role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ c.label }}"></button>
                {% endfor %}
            </div>
        </div>

        {% comment %} Includes share the page's scope, so this loads the driver once however many carousels a page has. {% endcomment %}
        {% unless creative_carousel_js %}
        {% assign creative_carousel_js = true %}
        <script defer src="{{ '/assets/js/project-carousel.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
        {% endunless %}

        {% else %}
        <div class="creative-set">
            {% for c in include.items %}
            <figure class="creative">
                <img class="creative__img" src="{{ c.image | relative_url }}" alt="{{ c.alt | default: c.label }}" loading="lazy">
                <figcaption class="creative__caption">
                    <strong>{{ c.label }}</strong>
                    {% if c.note %}<span>{{ c.note }}</span>{% endif %}
                </figcaption>
            </figure>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
{% endif %}
