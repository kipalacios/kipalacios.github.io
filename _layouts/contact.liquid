---
layout: default
---
{% comment %}
Contact page. Everything on it comes from pages/contact.md front matter:
one card per entry in `paths` (title, blurb, email, button, links, accent).
{% endcomment %}
<div class="call-out call-out_solid">
    <h1 class="call-out_title">{{ page.title }}</h1>
</div>

<section class="contact-page">
    {% if page.intro %}<p class="contact-page__intro">{{ page.intro }}</p>{% endif %}

    {% comment %}
    Message form. The site is static, so messages are delivered by FormSubmit
    (formsubmit.co, free, no account). contact-form.js reads the chosen
    topic's data-email and posts to that address, so each topic lands in its
    own inbox. Without JS the form still posts (to the first address) with
    the topic included in the message. Each address must be activated once:
    FormSubmit emails a confirmation link on its first submission.
    {% endcomment %}
    {% assign first_path = page.paths | first %}
    <form class="contact-form" action="https://formsubmit.co/{{ first_path.email }}" method="POST" data-contact-form novalidate>
        <h2 class="contact-form__title">Send a message</h2>

        <div class="contact-form__row">
            <label class="contact-form__field">
                <span class="contact-form__label">Name</span>
                <input type="text" name="name" autocomplete="name" required>
            </label>
            <label class="contact-form__field">
                <span class="contact-form__label">Email</span>
                <input type="email" name="email" autocomplete="email" required>
            </label>
        </div>

        <label class="contact-form__field">
            <span class="contact-form__label">What's this about?</span>
            <select name="topic" required data-contact-topic>
                <option value="" disabled selected>Choose one…</option>
                {% for p in page.paths %}
                <option value="{{ p.title }}" data-email="{{ p.email }}">{{ p.title }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="contact-form__field">
            <span class="contact-form__label">Message</span>
            <textarea name="message" rows="6" required></textarea>
        </label>

        <input type="text" name="_honey" class="contact-form__honey" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="_template" value="table">

        <button type="submit" class="button contact-form__submit" data-contact-submit>Send Message</button>
        <p class="contact-form__status" data-contact-status role="status" aria-live="polite"></p>
    </form>

    <h2 class="contact-page__or">Or email me directly</h2>

    <div class="contact-page__grid">
        {% for p in page.paths %}
        <div class="contact-card{% if p.accent %} contact-card--{{ p.accent }}{% endif %}">
            <h2 class="contact-card__title">{{ p.title }}</h2>
            {% if p.blurb %}<p class="contact-card__blurb">{{ p.blurb }}</p>{% endif %}
            <a class="button contact-card__button" href="mailto:{{ p.email }}">{{ p.button | default: 'Email Me' }}</a>
            <p class="contact-card__email">{{ p.email }}</p>
            {% if p.links %}
            <ul class="contact-card__links">
                {% for l in p.links %}
                {% assign external = l.url | slice: 0, 4 %}
                <li><a href="{% if external == 'http' %}{{ l.url }}{% else %}{{ l.url | relative_url }}{% endif %}"{% if external == 'http' %} target="_blank" rel="noopener"{% endif %}><i class="{{ l.icon }}" aria-hidden="true"></i> {{ l.label }}</a></li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
        {% endfor %}
    </div>

    {% if page.location %}
    <p class="contact-page__location">
        {% include home/sparkle.liquid class="contact-page__sparkle" %}
        {{ page.location }}
    </p>
    {% endif %}
</section>

<script defer src="{{ '/assets/js/contact-form.js' | relative_url }}?v={{ site.time | date: '%s' }}"></script>
